{
  "expo": {
    "name": "vesta-app",
    "slug": "vesta-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-reduzido_vesta.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/logo_vesta.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo-reduzido_vesta.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.fiaper.vestaapp"
    },
    "web": {
      "favicon": "./assets/images/logo-reduzido_vesta.png"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "36cf540b-2d14-440d-906b-672987fc183a"
      }
    }
  }
}
